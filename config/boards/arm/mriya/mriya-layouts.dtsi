#include <physical_layouts.dtsi>

/ {
    mriya_layout: mriya_layout {
        compatible = "zmk,physical-layout";
        display-name = "Mriya";
        transform = <&default_transform>;

        mriya_left_map: left {
            compatible = "zmk,physical-layout";
            display-name = "Mriya Left";
            transform = <&default_transform>;
            keys = <
                // Row 0
                &key_physical_attrs 100 100  100  75    0    0    0
                &key_physical_attrs 100 100  200  63    0    0    0
                &key_physical_attrs 100 100  300  25    0    0    0
                &key_physical_attrs 100 100  400   0    0    0    0
                &key_physical_attrs 100 100  500  25    0    0    0
                &key_physical_attrs 100 100  600  38    0    0    0

                // Row 1
                &key_physical_attrs 100 100    0 250    0    0    0
                &key_physical_attrs 100 100  100 175    0    0    0
                &key_physical_attrs 100 100  200 163    0    0    0
                &key_physical_attrs 100 100  300 125    0    0    0
                &key_physical_attrs 100 100  400 100    0    0    0
                &key_physical_attrs 100 100  500 125    0    0    0
                &key_physical_attrs 100 100  600 138    0    0    0

                // Row 2
                &key_physical_attrs 100 100  100 275    0    0    0
                &key_physical_attrs 100 100  200 263    0    0    0
                &key_physical_attrs 100 100  300 225    0    0    0
                &key_physical_attrs 100 100  400 200    0    0    0
                &key_physical_attrs 100 100  500 225    0    0    0
                &key_physical_attrs 100 100  600 238    0    0    0

                // Row 3
                &key_physical_attrs 100 100  100 375    0    0    0
                &key_physical_attrs 100 100  200 363    0    0    0
                &key_physical_attrs 100 100  300 325    0    0    0
                &key_physical_attrs 100 100  400 300    0    0    0
                &key_physical_attrs 100 100  500 325    0    0    0
                &key_physical_attrs 100 100  600 338    0    0    0

                // Row 4 (thumb keys)
                &key_physical_attrs 100 100  375 435 (-12)  475 535
                &key_physical_attrs 100 100  475 435    0    0   0
                &key_physical_attrs 100 100  600 438   15  600 438
                &key_physical_attrs 100 100  670 460   30  670 560
            >;
        };

        mriya_right_map: right {
            compatible = "zmk,physical-layout";
            display-name = "Mriya Right";
            transform = <&default_transform>;
            keys = <
                // Row 0
                &key_physical_attrs 100 100 1200  38    0    0    0
                &key_physical_attrs 100 100 1300  25    0    0    0
                &key_physical_attrs 100 100 1400   0    0    0    0
                &key_physical_attrs 100 100 1500  25    0    0    0
                &key_physical_attrs 100 100 1600  63    0    0    0
                &key_physical_attrs 100 100 1700  75    0    0    0

                // Row 1
                &key_physical_attrs 100 100 1200 138    0    0    0
                &key_physical_attrs 100 100 1300 125    0    0    0
                &key_physical_attrs 100 100 1400 100    0    0    0
                &key_physical_attrs 100 100 1500 125    0    0    0
                &key_physical_attrs 100 100 1600 163    0    0    0
                &key_physical_attrs 100 100 1700 175    0    0    0
                &key_physical_attrs 100 100 1800 250    0    0    0

                // Row 2
                &key_physical_attrs 100 100 1200 238    0    0    0
                &key_physical_attrs 100 100 1300 225    0    0    0
                &key_physical_attrs 100 100 1400 200    0    0    0
                &key_physical_attrs 100 100 1500 225    0    0    0
                &key_physical_attrs 100 100 1600 263    0    0    0
                &key_physical_attrs 100 100 1700 275    0    0    0

                // Row 3
                &key_physical_attrs 100 100 1200 338    0    0    0
                &key_physical_attrs 100 100 1300 325    0    0    0
                &key_physical_attrs 100 100 1400 300    0    0    0
                &key_physical_attrs 100 100 1500 325    0    0    0
                &key_physical_attrs 100 100 1600 363    0    0    0
                &key_physical_attrs 100 100 1700 375    0    0    0

                // Row 4 (thumb keys)
                &key_physical_attrs 100 100 1130 460 (-30) 1230 560
                &key_physical_attrs 100 100 1200 438 (-15) 1300 438
                &key_physical_attrs 100 100 1323 435    0    0   0
                &key_physical_attrs 100 100 1423 435   12 1423 535
            >;
        };
    };
}; 