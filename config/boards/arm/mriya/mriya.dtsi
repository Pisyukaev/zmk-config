/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include "mriya-layouts.dtsi"


/ {
	model = "mriya";
	compatible = "mriya";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,battery = &vbatt;
		zephyr,console = &cdc_acm_uart0;
		zmk,physical_layout = <&mriya_position_map>;
	};

	physical_layout: physical_layout {
		compatible = "zmk,physical-layout";
		display-name = "Mriya";
		transform = <&default_transform>;
		keys = <
			// Row 0
			&key_physical_attrs 100 100  100  75    0    0    0
			&key_physical_attrs 100 100  200  63    0    0    0
			&key_physical_attrs 100 100  300  25    0    0    0
			&key_physical_attrs 100 100  400   0    0    0    0
			&key_physical_attrs 100 100  500  25    0    0    0
			&key_physical_attrs 100 100  600  38    0    0    0
			&key_physical_attrs 100 100 1200  38    0    0    0
			&key_physical_attrs 100 100 1300  25    0    0    0
			&key_physical_attrs 100 100 1400   0    0    0    0
			&key_physical_attrs 100 100 1500  25    0    0    0
			&key_physical_attrs 100 100 1600  63    0    0    0
			&key_physical_attrs 100 100 1700  75    0    0    0

			// Row 1
			&key_physical_attrs 100 100    0 250    0    0    0
			&key_physical_attrs 100 100  100 175    0    0    0
			&key_physical_attrs 100 100  200 163    0    0    0
			&key_physical_attrs 100 100  300 125    0    0    0
			&key_physical_attrs 100 100  400 100    0    0    0
			&key_physical_attrs 100 100  500 125    0    0    0
			&key_physical_attrs 100 100  600 138    0    0    0
			&key_physical_attrs 100 100 1200 138    0    0    0
			&key_physical_attrs 100 100 1300 125    0    0    0
			&key_physical_attrs 100 100 1400 100    0    0    0
			&key_physical_attrs 100 100 1500 125    0    0    0
			&key_physical_attrs 100 100 1600 163    0    0    0
			&key_physical_attrs 100 100 1700 175    0    0    0
			&key_physical_attrs 100 100 1800 250    0    0    0

			// Row 2
			&key_physical_attrs 100 100  100 275    0    0    0
			&key_physical_attrs 100 100  200 263    0    0    0
			&key_physical_attrs 100 100  300 225    0    0    0
			&key_physical_attrs 100 100  400 200    0    0    0
			&key_physical_attrs 100 100  500 225    0    0    0
			&key_physical_attrs 100 100  600 238    0    0    0
			&key_physical_attrs 100 100 1200 238    0    0    0
			&key_physical_attrs 100 100 1300 225    0    0    0
			&key_physical_attrs 100 100 1400 200    0    0    0
			&key_physical_attrs 100 100 1500 225    0    0    0
			&key_physical_attrs 100 100 1600 263    0    0    0
			&key_physical_attrs 100 100 1700 275    0    0    0

			// Row 3
			&key_physical_attrs 100 100  100 375    0    0    0
			&key_physical_attrs 100 100  200 363    0    0    0
			&key_physical_attrs 100 100  300 325    0    0    0
			&key_physical_attrs 100 100  400 300    0    0    0
			&key_physical_attrs 100 100  500 325    0    0    0
			&key_physical_attrs 100 100  600 338    0    0    0
			&key_physical_attrs 100 100 1200 338    0    0    0
			&key_physical_attrs 100 100 1300 325    0    0    0
			&key_physical_attrs 100 100 1400 300    0    0    0
			&key_physical_attrs 100 100 1500 325    0    0    0
			&key_physical_attrs 100 100 1600 363    0    0    0
			&key_physical_attrs 100 100 1700 375    0    0    0

			// Row 4 (thumb keys)
			&key_physical_attrs 100 100  375 435  -12  475 535
			&key_physical_attrs 100 100  475 435    0    0   0
			&key_physical_attrs 100 100  600 438   15  600 438
			&key_physical_attrs 100 100  670 460   30  670 560
			&key_physical_attrs 100 100 1130 460  -30 1230 560
			&key_physical_attrs 100 100 1200 438  -15 1300 438
			&key_physical_attrs 100 100 1323 435    0    0   0
			&key_physical_attrs 100 100 1423 435   12 1423 535
		>;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <5>;
		map = <
					RC(0,5) RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(4,5) RC(1,5) RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(4,11)
                    RC(2,5) RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                    RC(3,5) RC(3,4) RC(3,3) RC(3,2) RC(3,1) RC(3,0)  RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                    RC(4,3) RC(4,2) RC(4,1) RC(4,0)  RC(4,6) RC(4,7) RC(4,8) RC(4,9)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";

		wakeup-source;

		diode-direction = "col2row";
		row-gpios
			= <&gpio0  7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio1  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpio0 23 GPIO_ACTIVE_HIGH>;
			label = "Blue LED";
		};
	};

	vbatt: vbatt {
		compatible = "zmk,battery-voltage-divider";
		label = "VBATT";
		io-channels = <&adc 0>;
		output-ohms = <2000000>;
		full-ohms = <(2000000 + 806000)>;
	};

};


&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&usbd {
    status = "okay";
};

zephyr_udc0: &usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
    reg = <0x40027000 0x1000>;
    interrupts = <39 1>;
    num-bidir-endpoints = <1>;
    num-in-endpoints = <7>;
    num-out-endpoints = <7>;
    num-isoin-endpoints = <1>;
    num-isoout-endpoints = <1>;
    cdc_acm_uart0: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
    };
};

&flash0 {
	/*
	 * For more information, see:
	 * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		sd_partition: partition@0 {
			label = "softdevice";
			reg = <0x00000000 0x00026000>;
		};
		code_partition: partition@26000 {
			label = "code_partition";
			reg = <0x00026000 0x000c6000>;
		};

		/*
		 * The flash starting at 0x000ec000 and ending at
		 * 0x000f3fff is reserved for use by the application.
		 */

		/*
		 * Storage partition will be used by FCB/LittleFS/NVS
		 * if enabled.
		 */
		storage_partition: partition@ec000 {
			label = "storage";
			reg = <0x000ec000 0x00008000>;
		};

		boot_partition: partition@f4000 {
			label = "adafruit_boot";
			reg = <0x000f4000 0x0000c000>;
		};
	};
};